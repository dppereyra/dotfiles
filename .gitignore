# --- Stowed-tree runtime state -------------------------------------------
# ~/.config/station is a symlink INTO this repo, so anything the installers or
# tools create under $STATION_HOME lands in this working tree. None of it is
# config: it is installed toolchains, caches and downloaded binaries.
/src/configs/.config/station/ansible/roles/
/src/configs/.config/station/appimages/
/src/configs/.config/station/bin/
/src/configs/.config/station/envs/
/src/configs/.config/station/npm/
/src/configs/.config/station/pnpm/
/src/configs/.config/station/zinit/

# Shell history: runtime state, and this repo is public.
/src/configs/.config/station/zsh_history

# Real, filled-in secrets. The *.sample.zsh templates ARE tracked; these are not.
# This is the correct place for them: ~/.config/station symlinks into this tree, so
# these files really do live here. station/global_gitignore is the global
# core.excludesfile for keeping personal artefacts out of OTHER (work/client)
# repos — it is not the mechanism for this repo's own contents.
/src/configs/.config/station/runcom/s97_work_config.zsh
/src/configs/.config/station/runcom/s98_secrets.zsh

# Defence in depth. The two rules above name the files we know about; these
# catch any other s97_*/s98_* variant (backups, .local, .work) that a future
# edit might leave behind. Only the *.sample.zsh templates stay tracked.
/src/configs/.config/station/runcom/s97_*
/src/configs/.config/station/runcom/s98_*
!/src/configs/.config/station/runcom/s97_*.sample.zsh
!/src/configs/.config/station/runcom/s98_*.sample.zsh

# Keys and work/client identity now live at ~/.config/secrets and ~/.config/work,
# which are deliberately OUTSIDE this repo (bootstrap.sh creates them empty) --
# ~/.config/station is a symlink into this working tree, so nothing sensitive
# should ever sit under it again. These rules are the backstop in case anything
# recreates the old locations.
/src/configs/.config/station/secrets/
/src/configs/.config/station/work/
/src/configs/.config/station/*.gitconfig
!/src/configs/.config/station/personal.gitconfig
!/src/configs/.config/station/station.gitconfig

# --- qutebrowser: browser state must never reach a public repo -------------
# ~/.config/qutebrowser is a symlink into this tree, so anything the browser
# writes at runtime lands here. Only the hand-maintained config is tracked
# (config.py, autoconfig.yml, quickmarks, bookmarks/); everything below is
# session state that can carry cookies, auth tokens, or browsing history.
/src/configs/.config/qutebrowser/cookies*
/src/configs/.config/qutebrowser/history.sqlite*
/src/configs/.config/qutebrowser/state
/src/configs/.config/qutebrowser/cmd-history
/src/configs/.config/qutebrowser/sessions/
/src/configs/.config/qutebrowser/webengine/
/src/configs/.config/qutebrowser/cache/
/src/configs/.config/qutebrowser/data/
/src/configs/.config/qutebrowser/qtwebengine_dictionaries/
/src/configs/.config/qutebrowser/blocked-hosts
/src/configs/.config/qutebrowser/greasemonkey/
# Belt and braces: any DB/journal/log the browser drops in its basedir.
/src/configs/.config/qutebrowser/**/*.sqlite
/src/configs/.config/qutebrowser/**/*.sqlite-wal
/src/configs/.config/qutebrowser/**/*.sqlite-shm
/src/configs/.config/qutebrowser/**/*.db
/src/configs/.config/qutebrowser/**/*.log

Include /Users/dppereyra/.colima/ssh_config

Include ~/.ssh/conf.d/*.conf
Include ~/.ssh/work.d/*.conf

# DevPod Start testbed.devpod
Host testbed.devpod
  ForwardAgent yes
  LogLevel error
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  HostKeyAlgorithms rsa-sha2-256,rsa-sha2-512,ssh-rsa
  ProxyCommand "/Applications/DevPod.app/Contents/MacOS/devpod-cli" ssh --stdio --context default --user dev testbed --workdir "/workspaces/base"
  User dev
# DevPod End testbed.devpod
Host *
  IdentitiesOnly        yes
  ForwardAgent          yes
  ServerAliveInterval   60
  StrictHostKeyChecking no
  UserKnownHostsFile    /dev/null